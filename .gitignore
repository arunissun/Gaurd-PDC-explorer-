.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

data/*
!data/.gitkeep
data/index/*
!data/index/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/manifests/*
!data/manifests/.gitkeep

outputs/*
!outputs/.gitkeep
outputs/notebook/*
!outputs/notebook/.gitkeep
outputs/dashboard/*
!outputs/dashboard/.gitkeep
outputs/exports/*
!outputs/exports/.gitkeep

*.sqlite
*.sqlite3
*.jsonl
!tests/fixtures/*.jsonl
*.html

# Local-only tool settings
.claude/settings.local.json
